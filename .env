# General
DRY_RUN=false
CV_PATH=SAURAV KUMAR UPDATED CV.pdf
TRACKER_PATH=outreach_tracker.xlsx
MAX_PER_RUN=20

# Your sender identity
SENDER_NAME=Your Name
SENDER_EMAIL=your_email@gmail.com

# Email SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_USE_TLS=true

# Outreach delays (seconds)
EMAIL_DELAY_MIN=60
EMAIL_DELAY_MAX=120
WHATSAPP_DELAY_MIN=90
WHATSAPP_DELAY_MAX=180

# WhatsApp
WHATSAPP_HEADLESS=false
WHATSAPP_TIMEOUT_MS=45000

# Message controls
EMAIL_SUBJECT=Application for Cloud / DevOps Engineer Opportunities

AUTO_SEND_WHATSAPP=true

# Debug Logging
DEBUG_ENABLED=false
DEBUG_OUTPUT_DIR=debug_logs
